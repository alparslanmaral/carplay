# Copy to .env (never commit .env). These are public OAuth client IDs, not secrets,
# but they are kept out of the repo so each deployment uses its own.

# Spotify Developer Dashboard > your app > Client ID (Authorization Code + PKCE, no client secret)
VITE_SPOTIFY_CLIENT_ID=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
VITE_GOOGLE_CLIENT_ID=
